{
  "rules": {
    "submissions": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || (auth != null && query.orderByChild == 'uid' && query.equalTo == auth.uid) || (auth != null && auth.token.email_verified == true && query.orderByChild == 'email' && query.equalTo == auth.token.email)",
      ".indexOn": [
        "uid",
        "email",
        "timestamp"
      ],
      "$id": {
        ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || (auth != null && data.child('uid').val() == auth.uid) || (auth != null && auth.token.email_verified == true && data.child('email').val() == auth.token.email)",
        ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['type', 'name', 'email', 'timestamp'])",
        "type": {
          ".validate": "newData.val() == 'quote_request' || newData.val() == 'contact'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "uid": {
          ".validate": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || (auth != null && newData.val() == auth.uid)"
        },
        "status": {
          ".validate": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || newData.val() == 'new'"
        },
        "read": {
          ".validate": "newData.isBoolean() && ((auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true) || newData.val() == false)"
        },
        "updates": {
          ".validate": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
        }
      }
    },
    "visitors": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      "$visitorId": {
        ".write": true
      }
    },
    "events": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      "$visitorId": {
        ".write": true
      }
    },
    "activeUsers": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
    },
    "chats": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
    },
    "userChats": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
    },
    "globalChat": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
    },
    "adminChats": {
      ".read": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)",
      ".write": "(auth != null && auth.token.email == 'support@custompc.tech' && auth.token.email_verified == true)"
    }
  }
}
